
<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Transaction Gateway Status</title>
 
 <!-- Tailwind CSS & Google Fonts -->
 <script src="https://cdn.tailwindcss.com"></script>
 <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
 
 <!-- Canvas Confetti for Success Effect -->
 <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

 <style>
 body { font-family: 'Plus Jakarta Sans', sans-serif; }
 .font-mono { font-family: 'JetBrains Mono', sans-serif; }

 /* Complex Animated Background */
 .premium-bg {
 background-color: #060814;
 background-image: 
 linear-gradient(rgba(18, 24, 48, 0.3) 1px, transparent 1px),
 linear-gradient(90deg, rgba(18, 24, 48, 0.3) 1px, transparent 1px);
 background-size: 40px 40px;
 background-position: center;
 }

 /* Glowing Orbs */
 .orb {
 position: absolute;
 width: 500px;
 height: 500px;
 border-radius: 50%;
 filter: blur(120px);
 opacity: 0.15;
 pointer-events: none;
 mix-blend-mode: screen;
 animation: floatOrb 10s infinite alternate ease-in-out;
 }

 @keyframes floatOrb {
 0% { transform: translate(0, 0) scale(1); }
 100% { transform: translate(40px, 30px) scale(1.1); }
 }

 /* Border Glow Animation */
 .glow-card {
 background: linear-gradient(135deg, rgba(20, 27, 54, 0.9) 0%, rgba(10, 14, 30, 0.95) 100%);
 border: 1px solid rgba(255, 255, 255, 0.08);
 box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
 position: relative;
 }

 .glow-card::before {
 content: '';
 position: absolute;
 inset: -1px;
 border-radius: 24px;
 padding: 1px;
 background: linear-gradient(to bottom right, rgba(255,255,255,0.15), transparent, rgba(255,255,255,0.03));
 -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
 -webkit-mask-composite: xor;
 mask-composite: exclude;
 pointer-events: none;
 }

 /* Simulated Scanning Shimmer */
 .shimmer {
 background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
 background-size: 200% 100%;
 animation: shimmerEffect 2s infinite linear;
 }

 @keyframes shimmerEffect {
 0% { background-position: -200% 0; }
 100% { background-position: 200% 0; }
 }
 </style>
</head>
<body class="premium-bg min-h-screen flex items-center justify-center p-4 text-white relative overflow-hidden">

 <!-- Ambient Glow Backgrounds -->
 <div id="orb-primary" class="orb bg-emerald-500 top-[-10%] left-[-10%]"></div>
 <div id="orb-secondary" class="orb bg-blue-500 bottom-[-10%] right-[-10%]"></div>

 <!-- 1. LOADING SCREEN (Simulated Node Verification) -->
 <div id="loading-state" class="text-center z-10 transition-all duration-500">
 <div class="relative w-20 h-20 mx-auto mb-6">
 <div class="absolute inset-0 rounded-full border-4 border-slate-800"></div>
 <div class="absolute inset-0 rounded-full border-4 border-t-blue-500 border-r-emerald-500 animate-spin"></div>
 </div>
 <p class="text-sm font-mono tracking-[0.3em] text-slate-400 uppercase animate-pulse">Securing Gateway Connection...</p>
 <p class="text-xs text-slate-600 font-mono mt-2">Checking signature hashes...</p>
 </div>

 <!-- 2. MAIN COMPLEX DASHBOARD CARD (Hidden Initially) -->
 <div id="main-card" class="glow-card w-full max-w-lg rounded-3xl p-8 md:p-10 hidden z-10 opacity-0 transform translate-y-8 transition-all duration-700 ease-out">
 
 <!-- Top Status Bar & Tech Badge -->
 <div class="flex justify-between items-center mb-8 pb-4 border-b border-slate-800/60">
 <div class="flex items-center gap-2">
 <span class="relative flex h-2 w-2">
 <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
 <span id="status-dot" class="relative inline-flex rounded-full h-2 w-2"></span>
 </span>
 <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400" id="badge-network">Network Node: MID-LIVE</span>
 </div>
 <div class="text-[10px] font-mono px-2 py-1 bg-slate-800/60 rounded border border-slate-700 text-slate-400">
 TLS_AES_256_GCM
 </div>
 </div>

 <!-- Dynamic Icon Visual Area -->
 <div class="text-center mb-8 relative">
 <div id="icon-container" class="mx-auto w-24 h-24 rounded-2xl flex items-center justify-center relative shadow-inner overflow-hidden">
 <!-- Inner technical rotators -->
 <div class="absolute inset-2 border border-dashed rounded-xl opacity-20 animate-spin" style="animation-duration: 20s;"></div>
 
 <!-- Success Check Icon -->
 <svg id="icon-success" class="w-10 h-10 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
 </svg>
 <!-- Failed Cross Icon -->
 <svg id="icon-failed" class="w-10 h-10 text-rose-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
 </svg>
 </div>
 
 <h1 id="status-title" class="text-2xl md:text-3xl font-extrabold tracking-tight mt-4">Initializing Status</h1>
 <p id="status-subtitle" class="text-xs text-slate-400 mt-1 font-medium tracking-wide">Proses Enkripsi Selesai</p>
 </div>

 <!-- Complex Order ID Container -->
 <div class="bg-black/40 rounded-2xl p-5 border border-slate-800/80 relative group overflow-hidden">
 <div class="absolute inset-0 shimmer pointer-events-none"></div>
 
 <div class="flex justify-between items-center mb-3">
 <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-slate-500 font-bold">Encrypted Reference ID</span>
 <span class="text-[9px] font-mono text-emerald-500/80 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20 uppercase tracking-wider">Verified</span>
 </div>

 <!-- Display ID Box -->
 <div class="flex items-center justify-between gap-3 bg-slate-900/50 p-3.5 rounded-xl border border-slate-800">
 <p id="order-id-text" class="text-lg md:text-xl font-mono font-bold text-slate-200 select-all tracking-wide break-all">
 FETCHING_ID_ERR
 </p>
 
 <!-- Clipboard Copy Action Button -->
 <button id="copy-btn" class="p-2 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 hover:text-white rounded-lg border border-slate-700 transition duration-200" title="Copy Order ID">
 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
 </svg>
 </button>
 </div>

 <!-- Faux Decorative Barcode to look Complex -->
 <div class="mt-4 pt-4 border-t border-slate-800/60 flex items-center justify-between opacity-40 group-hover:opacity-60 transition-opacity duration-300">
 <div class="flex gap-[2px] h-5 items-center">
 <div class="w-1 h-full bg-slate-400"></div><div class="w-[2px] h-full bg-slate-400"></div><div class="w-3 h-full bg-slate-400"></div><div class="w-[1px] h-full bg-slate-400"></div><div class="w-2 h-full bg-slate-400"></div><div class="w-[2px] h-full bg-slate-400"></div><div class="w-4 h-full bg-slate-400"></div>
 </div>
 <span class="text-[9px] font-mono text-slate-500">SYSTEM_AUTH_DIGEST</span>
 </div>
 </div>

 <!-- Footer Tech Info -->
 <div class="mt-8 text-center">
 <p class="text-[10px] font-mono text-slate-600">Secure automated callback by Midtrans Snap Engine &bull; 2026</p>
 </div>
 </div>

 <!-- Interactive Toast Notification Component -->
 <div id="toast" class="fixed bottom-6 bg-slate-900 border border-slate-700 text-slate-200 text-xs px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 z-50 font-mono">
 <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
 </svg>
 Order ID copied to clipboard!
 </div>

 <!-- Script Handling Logic (Parsing, Confetti, Animations) -->
 <script>
 document.addEventListener('DOMContentLoaded', () => {
 // 1. Parsing System Configs dari URL Param
 const urlParams = new URLSearchParams(window.location.search);
 
 // Definisikan default jika param kosong untuk keperluan testing
 // Contoh testing: payment-status.html?status=success&order_id=MID-99201-9X
 const status = urlParams.get('status') || 'success'; 
 const orderId = urlParams.get('order_id') || 'MID-SAMPLE-774900X';

 const loadingState = document.getElementById('loading-state');
 const mainCard = document.getElementById('main-card');
 
 // 2. Simulasi loading "Verification Node" (1.5 Detik agar terasa kompleks & mahal)
 setTimeout(() => {
 loadingState.classList.add('opacity-0', 'scale-95');
 
 setTimeout(() => {
 loadingState.style.display = 'none';
 setupDashboard(status, orderId);
 }, 500);
 }, 1500);

 function setupDashboard(status, orderId) {
 const iconContainer = document.getElementById('icon-container');
 const title = document.getElementById('status-title');
 const subtitle = document.getElementById('status-subtitle');
 const orderText = document.getElementById('order-id-text');
 
 const dot = document.getElementById('status-dot');
 const ping = document.getElementById('status-ping');
 const primaryOrb = document.getElementById('orb-primary');

 // Inject Data ID
 orderText.textContent = orderId;

 // 3. Conditional Theme Formatting (Success vs Failed Rendering)
 if (status === 'success') {
 // Update Texts
 title.textContent = "Pembayaran Berhasil";
 title.classList.add('text-slate-100');
 subtitle.textContent = "Transaksi Anda telah divalidasi dan dicatat oleh sistem.";
 
 // UI Theme Accents
 iconContainer.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30');
 document.getElementById('icon-success').classList.remove('hidden');
 dot.classList.add('bg-emerald-400');
 ping.classList.add('bg-emerald-400/40');
 
 // Fire Confetti Trigger
 triggerConfetti();
 } else {
 // Update Texts ke Failed State
 title.textContent = "Pembayaran Gagal";
 title.classList.add('text-rose-400');
 subtitle.textContent = "Autentikasi gerbang pembayaran ditolak atau dibatalkan.";
 
 // UI Theme Accents ke Danger/Warm Tone
 iconContainer.classList.add('bg-rose-500/10', 'border', 'border-rose-500/30');
 document.getElementById('icon-failed').classList.remove('hidden');
 dot.classList.add('bg-rose-500');
 ping.classList.add('bg-rose-500/40');
 
 // Shift bg orbs to match failure palette
 primaryOrb.classList.replace('bg-emerald-500', 'bg-rose-600');
 }

 // Reveal Card with elegant entry transition
 mainCard.classList.remove('hidden');
 setTimeout(() => {
 mainCard.classList.remove('opacity-0', 'translate-y-8');
 }, 50);
 }

 // 4. Clipboard Functionality Logic
 document.getElementById('copy-btn').addEventListener('click', () => {
 const textToCopy = document.getElementById('order-id-text').textContent.trim();
 navigator.clipboard.writeText(textToCopy).then(() => {
 const toast = document.getElementById('toast');
 toast.classList.remove('translate-y-20', 'opacity-0');
 
 setTimeout(() => {
 toast.classList.add('translate-y-20', 'opacity-0');
 }, 2500);
 });
 });

 // Celebration Engine Burst
 function triggerConfetti() {
 let duration = 2 * 1000;
 let animationEnd = Date.now() + duration;
 let defaults = { startVelocity: 25, spread: 360, ticks: 50, zIndex: 0 };

 function randomInRange(min, max) { return Math.random() * (max - min) + min; }

 let interval = setInterval(function() {
 let timeLeft = animationEnd - Date.now();
 if (timeLeft <= 0) return clearInterval(interval);

 let particleCount = 40 * (timeLeft / duration);
 confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
 confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
 }, 250);
 }
 });
 </script>
</body>
</html>